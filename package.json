    "@types/react": "~19.1.17",
    "@vitest/coverage-v8": "^4.1.1",
    "@vitest/ui": "^4.1.1",
    "commitlint": "^20.5.0",
    "eslint": "^10.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "maestro": "^2.1.1",
    "semantic-release": "^25.0.3",
    "typescript": "~5.9.3",
